      "flutter": "Cubic(0.2, 0.0, 0.0, 1.0)"
    },
    "decelerate": {
      "cubicBezier": [0.05, 0.7, 0.1, 1.0],
      "android": "new android.view.animation.PathInterpolator(0.05f, 0.7f, 0.1f, 1.0f)",
      "flutter": "Cubic(0.05, 0.7, 0.1, 1.0)"
    },
    "accelerate": {
      "cubicBezier": [0.3, 0.0, 0.8, 0.15],
      "android": "new android.view.animation.PathInterpolator(0.3f, 0.0f, 0.8f, 0.15f)",
      "flutter": "Cubic(0.3, 0.0, 0.8, 0.15)"
    },
    "linear": {
      "cubicBezier": [0.0, 0.0, 1.0, 1.0],
      "android": "new android.view.animation.LinearInterpolator()",
      "flutter": "Curves.linear"
    }
  },
  "springs": {
    "formulas": {
      "omegaRadPerSec": "2 * pi / response",
      "stiffness": "mass * pow(2 * pi / response, 2)",
      "viscousDamping": "2 * dampingRatio * sqrt(stiffness * mass)",
      "androidMotionSpring": "new MotionSpring(initial, motionSpringFrequency, 0.0025f) // first-party zero-dependency critically-damped solver (dampingRatio == 1.0); androidx.dynamicanimation is NOT in android/*dependencies.json and must not be added",
      "androidUnderdampedSolver": "MotionTokens.stepUnderdampedSpring(...) or PathInterpolator fallback // zero-dependency analytical damped-harmonic helper in MotionTokens.java for dampingRatio < 1.0",
      "flutterSpringDescription": "SpringDescription(mass: mass, stiffness: stiffness, damping: viscousDamping)"
    },
    "presets": {
      "tvFocus": {
        "response": 0.21,
        "dampingRatio": 1.0,
