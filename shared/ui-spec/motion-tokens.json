  "accessibilitySubstitutions": {
    "reduceMotion": {
      "androidCondition": "Prefs.REDUCED (MainActivity.reduced == true)",
      "flutterCondition": "MediaQuery.disableAnimationsOf(context)",
      "rules": {
        "pageAndPlayerTransition": {
          "mode": "crossFade",
          "durationMs": 150,
          "curve": "linear",
          "scale": 1.0,
          "shaderEnabled": false
        },
        "tvAndCardFocus": {
          "mode": "snap",
          "durationMs": 0,
          "focusScale": 1.0,
          "keepFocusStrokeAndFill": true
        },
        "hudOverlays": {
          "mode": "opacityOnly",
          "durationMs": 120,
          "curve": "linear",
          "translateDp": 0
        },
        "auroraBackground": {
          "mode": "staticFrame",
          "frozenTimeSec": 0.0,
          "tickerRunning": false
        },
        "brandLogoLoader": {
          "mode": "staticBreathingAlpha",
          "cycleMs": 1600,
          "minAlpha": 0.72,
          "maxAlpha": 1.0
        }
      }
    },
    "reduceTransparency": {
      "androidCondition": "Prefs.REDUCED_TRANSPARENCY",
      "flutterCondition": "IosLiquidGlassBridge.reduceTransparency || GlassworkBackdrop.reduceTransparency.value || storage.glassBlurLevel == 'solid' || MediaQuery.highContrastOf(context)",
      "rules": {
        "glassSurfaceFillArgb": "#F51E1E22",
        "hudBackdropFillArgb": "#EB16161A",
        "useBadgeSolidFill": true,
        "minBorderAlpha": 0.45,
        "disableShaderRefraction": true
      }
    }
  },
  "scaleTokens": {
    "androidUiScalePercent": {
      "100": 1.0,
